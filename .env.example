TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=

# Comma-separated Telegram numeric user IDs allowed to use the bot.
# Message @userinfobot on Telegram to get your own ID.
ALLOWED_TELEGRAM_USER_IDS=

# Used by docker-compose.yml to provision local Postgres — keep the values below
# in sync with the DATABASE_URL line, since Node reads DATABASE_URL directly
# rather than re-composing it from the other three.
POSTGRES_USER=receipt_bot
POSTGRES_PASSWORD=pick-your-own-local-password
POSTGRES_DB=receipt_bot

DATABASE_URL=postgres://receipt_bot:pick-your-own-local-password@localhost:5432/receipt_bot
REDIS_URL=redis://localhost:6379

# Production only — leave unset locally (that's what selects polling mode).
# WEBHOOK_URL=https://your-app.fly.dev
# WEBHOOK_SECRET=any-random-string, e.g. `openssl rand -hex 32`
